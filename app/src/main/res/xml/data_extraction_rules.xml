<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup/transfer policy (Android 12+, API 31+).

    The app's promise is that trip data stays on the device (SPEC section 1/3: no accounts,
    no cloud sync, "nothing leaves the phone"). So we DISABLE cloud backup entirely — no
    Room database, SharedPreferences, or files are uploaded to Google's backup servers.

    Direct device-to-device transfer (the new-phone setup flow) IS allowed, since that's a
    local hand-off the user explicitly initiates and keeps data on devices they own.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allow everything to move to a new device the user is setting up. -->
    </device-transfer>
</data-extraction-rules>
