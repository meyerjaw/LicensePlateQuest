<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overdue-trip reminder notifications (playtest #13). Runtime-requested on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LicensePlateQuestApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LicensePlateQuest">

        <!-- Experimental Android XR: launch into Full Space so the spatial panel shows on a headset.
             Ignored on phones/tablets. (Value may need tweaking against the alpha Jetpack XR SDK.) -->
        <property
            android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
            android:value="XR_ACTIVITY_START_MODE_FULL_SPACE_MANAGED" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name_short"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LicensePlateQuest">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles the overdue-trip notification action buttons (End trip / Remind later). -->
        <receiver
            android:name=".notifications.ReminderActionReceiver"
            android:exported="false" />

        <!-- Home-screen widget for the active trip (Glance). -->
        <receiver
            android:name=".widget.TripWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/trip_widget_info" />
        </receiver>

        <!-- Shares generated trip images from the cache via a content URI (playtest note #4). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
